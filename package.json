{
  "name": "habitat",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "description": "Event operating system: production, stages, audience, operations — on Cloudflare Workers, Durable Objects and D1, signed in with Cloudflare Access + WARP.",
  "scripts": {
    "build": "vite build",
    "dev": "vite build && wrangler dev",
    "dev:ui": "vite",
    "db:migrate:local": "wrangler d1 migrations apply habitat --local",
    "db:migrate:remote": "wrangler d1 migrations apply habitat --remote",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "hono": "^4.13.0",
    "jose": "^6.2.0",
    "partyserver": "^0.5.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  }
}
